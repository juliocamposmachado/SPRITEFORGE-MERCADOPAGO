# Mercado Pago Access Token (SECRET - nunca enviar ao GitHub)
MP_ACCESS_TOKEN=COLE_O_ACCESS_TOKEN_NA_VERCEL

# Segredo de assinatura de Webhooks, gerado/configurado no painel Mercado Pago
MP_WEBHOOK_SECRET=COLE_O_SEGREDO_DO_WEBHOOK_NA_VERCEL

# Chave aleatória longa para proteger o endpoint MCP
SPRITEFORGE_MCP_SECRET=GERE_UMA_CHAVE_LONGA_E_ALEATORIA

# Opcional: restringe a consulta ao plano correto. Deixe vazio até configurar.
MP_PREAPPROVAL_PLAN_ID=
